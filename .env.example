# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://socuser:socpassword@localhost:5432/socdb
DATABASE_SYNC_URL=postgresql://socuser:socpassword@localhost:5432/socdb

POSTGRES_DB=socdb
POSTGRES_USER=socuser
POSTGRES_PASSWORD=socpassword

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                     # "gemini" or "openai"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ─── ChromaDB / RAG ───────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_KNOWLEDGE=soc_knowledge

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Reports ──────────────────────────────────────────────────────────────────
REPORTS_DIR=./generated_reports

# ─── Demo Seed User ───────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=analyst@demo.com
SEED_ADMIN_PASSWORD=demo1234
